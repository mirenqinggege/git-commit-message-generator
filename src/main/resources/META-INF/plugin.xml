<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.mirenqinggege.gitcommit</id>
    <name>Git Commit Message Generator</name>
    <vendor>mirenqinggege</vendor>
    <resource-bundle>messages.GitCommitMessageBundle</resource-bundle>
    <description><![CDATA[
        <p>Generate a Conventional Commits message from the current Git diff directly in IntelliJ IDEA's Commit tool window.</p>
        <p>Configure any OpenAI-compatible API endpoint in Settings. Both the Completions and Responses APIs are supported.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Git Commit Message Generator" displayType="BALLOON"
                           key="notification.group.git.commit.message.generator"/>
        <applicationConfigurable instance="com.mirenqinggege.gitcommit.settings.GitCommitMessageConfigurable"
                                 parentId="tools" key="settings.display.name"/>
    </extensions>
    <actions>
        <action id="GitCommitMessageGenerator.Generate"
                class="com.mirenqinggege.gitcommit.actions.GenerateCommitMessageAction">
            <add-to-group group-id="ChangesView.CommitToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
